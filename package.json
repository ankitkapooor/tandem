{
  "name": "tandem",
  "version": "0.2.4",
  "description": "One thread for you, Claude Code and Codex. Runs locally on top of your own CLI logins.",
  "type": "module",
  "bin": {
    "tandem": "bin/tandem.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "electron",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/tandem.js",
    "dev": "node bin/tandem.js --mock",
    "test": "node --test test/*.test.js",
    "app": "electron .",
    "dist": "electron-builder --mac --arm64 --x64 --publish never",
    "release": "npm version patch --no-git-tag-version && git commit -am \"Release\" && git push",
    "dist:dmg": "electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mermaid": "^11.4.0",
    "qrcode": "^1.5.4"
  },
  "license": "MIT",
  "main": "electron/main.mjs",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.tandem.desktop",
    "productName": "tandem",
    "files": [
      "bin/**",
      "src/**",
      "public/**",
      "electron/**",
      "package.json",
      "node_modules/mermaid/dist/**",
      "node_modules/qrcode/**",
      "build/icon.png",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "zip"
      ],
      "identity": null,
      "icon": "build/icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "artifactName": "tandem-mac-${arch}.${ext}"
  },
  "author": "Ankit Kapoor"
}
